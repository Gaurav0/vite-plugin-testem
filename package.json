    "vite-plugin",
    "testem",
    "testing"
  ],
  "author": "Gaurav Munjal <Gaurav0@aol.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaurav0/vite-plugin-testem.git"
  },
  "bugs": {
